  hour_of_day:
    enabled: false
    time_col: Time_Orderd
  day_of_week:
    enabled: false
    date_col: Order_Date
logging:
  level: INFO
  output_dir: logs
paths:
  models_dir: models
  logs_dir: logs
  predictions_dir: predictions

