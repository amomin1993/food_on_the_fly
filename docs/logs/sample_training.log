  random_state: 42
  val_split: 0.1
  date_col: Order_Date
  temporal_baseline_days: 40
  temporal_window_days: 7
  train_ratio: 0.7
  temporal_val_ratio: 0.15
  temporal_test_ratio: 0.15
features:
